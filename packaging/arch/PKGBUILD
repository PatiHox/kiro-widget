# Maintainer: Yevhenii Terentiev <123j123t@gmail.com>
#
# Builds from the local repository (this file lives in packaging/arch/), using the
# committed HEAD. Commit your changes before running makepkg.

pkgname=kiro-widget
pkgver=r0.0000000
pkgrel=1
pkgdesc='System tray widget to start, stop and inspect the Kiro Crew (kirocrew) gateway'
arch=('x86_64')
url='https://github.com/PatiHox/kiro-widget'
license=('MIT')
depends=('gcc-libs' 'glibc' 'kdialog' 'libnotify' 'polkit' 'xdg-utils')
makedepends=('cargo' 'git')
optdepends=('systemd: manage the kirocrew system service')
options=('!lto')
source=("$pkgname::git+file://${startdir}/../..")
sha256sums=('SKIP')

pkgver() {
  cd "$pkgname"
  printf 'r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
  cd "$pkgname/rust"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname/rust"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

package() {
  cd "$pkgname"
  install -Dm755 rust/target/release/kiro-widget-rs "$pkgdir/usr/bin/kiro-widget-rs"
  install -Dm644 packaging/arch/kiro-widget-rs.desktop \
    "$pkgdir/usr/share/applications/kiro-widget-rs.desktop"
  # Launch at login for every user; a same-named file in ~/.config/autostart overrides it.
  install -Dm644 packaging/arch/kiro-widget-rs.desktop \
    "$pkgdir/etc/xdg/autostart/kiro-widget-rs.desktop"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
